<script>
/*
  QUICK EDIT GUIDE
  1) Add outings inside the events array. Dates must use YYYY-MM-DD.
  2) Add photo stories inside the posts array.
  3) Upload photos to HubSpot Files, copy each public file URL, and paste it into image.
  4) This is a view-only page. Changes are made by editing and republishing this code.
*/
const events = [
  {
    date:"2026-11-21",
    title:"Home Depot Kids Workshop - Christmas Car Ornament",
    time:"9:00 AM",
    place:"Home Depot (Brea)",
    note:"Activities and crafts, then breakfast!",
    color:"coral"
  },
  {
    date:"2026-12-12",
    title:"BBBS Holiday Match Party",
    time:"11:00 AM - 2:00 PM",
    place:"Dave & Buster's (Irvine)",
    note:"Festive celebration filled with food, games, prizes, crafts, and plenty of cheer.",
    color:"lavender"
  }
];

const posts = [
  // Add Ira and Larissa's photo memories here after each outing:
  // { date:"November 21, 2026", title:"Our first outing", text:"We explored, made something fun, and enjoyed a special day together.", image:"PASTE_HUBSPOT_IMAGE_URL_HERE" }
];

const outingIdeas = [
  { icon:"🎨", title:"Craft & Create", tag:"Creative time", description:"Make greeting cards, decorate bookmarks, paint rocks, or try a simple seasonal craft together.", cost:"Low-cost • Supplies can be simple" },
  { icon:"🌳", title:"Park Picnic & Play", tag:"Fresh air", description:"Bring snacks from home, play on the playground, blow bubbles, or make up a little nature scavenger hunt.", cost:"Free • Bring a picnic blanket" },
  { icon:"📚", title:"Library Adventure", tag:"Explore & learn", description:"Visit the library, choose a few books, look for a children’s activity, or enjoy storytime if one is scheduled.", cost:"Free • Check the library calendar" },
  { icon:"🍓", title:"Farmers Market Stroll", tag:"Little discoveries", description:"Look at colorful fruits and flowers, listen to music, and let Ira choose one small treat if she’d like.", cost:"Free to browse • Optional small treat" },
  { icon:"🍂", title:"Nature Walk & Treasure Hunt", tag:"Outdoor fun", description:"Search for interesting leaves, flowers, birds, and tiny details. Take photos of favorite discoveries.", cost:"Free • A neighborhood walk works too" },
  { icon:"🧩", title:"Game & Story Afternoon", tag:"Cozy day", description:"Play a board game, make up a story, do a puzzle, or bring a favorite game to share.", cost:"Free • At home or another family-approved spot" }
];

let shown = new Date(); shown.setDate(1);
const monthTitle = document.getElementById("monthTitle");
const calendarDays = document.getElementById("calendarDays");
const upcomingEvents = document.getElementById("upcomingEvents");
const potentialEvents = document.getElementById("potentialEvents");

function renderCalendar(){
  const year=shown.getFullYear(), month=shown.getMonth();
  monthTitle.textContent=shown.toLocaleDateString(undefined,{month:"long",year:"numeric"});
  calendarDays.innerHTML="";
  const first=new Date(year,month,1), start=first.getDay(), count=new Date(year,month+1,0).getDate();
  const prevCount=new Date(year,month,0).getDate();
  const today=new Date(); today.setHours(0,0,0,0);
  for(let i=0;i<42;i++){
    let dayNum, date, outside=false;
    if(i<start){dayNum=prevCount-start+i+1;date=new Date(year,month-1,dayNum);outside=true;}
    else if(i>=start+count){dayNum=i-(start+count)+1;date=new Date(year,month+1,dayNum);outside=true;}
    else{dayNum=i-start+1;date=new Date(year,month,dayNum);}
    const key=[date.getFullYear(),String(date.getMonth()+1).padStart(2,"0"),String(date.getDate()).padStart(2,"0")].join("-");
    const cell=document.createElement("div"); cell.className="day"+(outside?" outside":"");
    if(date.getTime()===today.getTime())cell.classList.add("today");
    cell.innerHTML=`<div class="day-num">${dayNum}</div>`;
    events.filter(e=>e.date===key).forEach(e=>{
      const tag=document.createElement("span");tag.className="event-dot "+(e.color||"");tag.textContent=e.title;cell.appendChild(tag);
    });
    calendarDays.appendChild(cell);
  }
  const future=events.slice()
    .sort((a,b)=>a.date.localeCompare(b.date))
    .filter(e=>e.date>=today.toISOString().slice(0,10) && e.color==="coral")
    .slice(0,5);
  upcomingEvents.innerHTML=future.length?"":'<div class="empty">No outings added yet. Check back soon for our next adventure!</div>';
  future.forEach(e=>{
    const d=new Date(e.date+"T12:00:00");
    const row=document.createElement("div");row.className="event-row";
    row.innerHTML=`<div class="event-date">${d.toLocaleDateString(undefined,{month:"short"}).toUpperCase()}<br><span style="font-size:18px">${d.getDate()}</span></div><div><strong>${escapeHtml(e.title)}</strong><small>${escapeHtml(e.time||"Time to be confirmed")}${e.place?" · "+escapeHtml(e.place):""}${e.note?"<br>"+escapeHtml(e.note):""}</small></div>`;
    upcomingEvents.appendChild(row);
  });

  const ideas=events.slice()
    .sort((a,b)=>a.date.localeCompare(b.date))
    .filter(e=>e.date>=today.toISOString().slice(0,10) && e.color==="lavender");
  potentialEvents.innerHTML=ideas.length?"":'<div class="empty">No suggested outings right now. Add lavender events to the calendar when you have ideas to consider.</div>';
  ideas.forEach(e=>{
    const d=new Date(e.date+"T12:00:00");
    const row=document.createElement("div");row.className="event-row";
    row.innerHTML=`<div class="event-date" style="background:#eeeafb">${d.toLocaleDateString(undefined,{month:"short"}).toUpperCase()}<br><span style="font-size:18px">${d.getDate()}</span></div><div><strong>${escapeHtml(e.title)}</strong><small>${escapeHtml(e.time||"Date/time tentative")}${e.place?" · "+escapeHtml(e.place):""}${e.note?"<br>"+escapeHtml(e.note):""}</small></div>`;
    potentialEvents.appendChild(row);
  });
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
document.getElementById("prev").addEventListener("click",()=>{shown.setMonth(shown.getMonth()-1);renderCalendar();});
document.getElementById("next").addEventListener("click",()=>{shown.setMonth(shown.getMonth()+1);renderCalendar();});

function renderIdeas(){
  const grid=document.getElementById("ideasGrid");
  grid.innerHTML="";
  outingIdeas.forEach(idea=>{
    const card=document.createElement("article");
    card.className="idea-card";
    card.innerHTML=`<div class="idea-icon" aria-hidden="true">${idea.icon}</div>
      <span class="idea-tag">${escapeHtml(idea.tag)}</span>
      <h3>${escapeHtml(idea.title)}</h3>
      <p>${escapeHtml(idea.description)}</p>
      <div class="idea-meta">${escapeHtml(idea.cost)}</div>`;
    grid.appendChild(card);
  });
}

function renderPosts(){
  const grid=document.getElementById("blogGrid");
  if(!posts.length){grid.innerHTML='<div class="info-card" style="grid-column:1/-1"><h3>Our first adventure is waiting!</h3><p class="empty">After an outing, add a short story and a photo in the posts section of the code. Your photo journal will grow here over time.</p></div>';return;}
  posts.forEach(p=>{
    const card=document.createElement("article");card.className="blog-card";
    const photo=p.image?`<img src="${escapeHtml(p.image)}" alt="${escapeHtml(p.title||"Adventure photo")}">`:`<div class="blog-photo">Add a photo URL in the posts section</div>`;
    card.innerHTML=`<div class="blog-photo">${photo}</div><div class="blog-copy"><time>${escapeHtml(p.date||"")}</time><h3>${escapeHtml(p.title||"A day together")}</h3><p>${escapeHtml(p.text||"")}</p></div>`;
    grid.appendChild(card);
  });
}
function setTab(name){
  document.querySelectorAll(".panel").forEach(p=>p.classList.toggle("active",p.id===name));
  document.querySelectorAll("[data-tab]").forEach(a=>a.classList.toggle("active",a.dataset.tab===name));
  location.hash=name;
}
document.querySelectorAll("[data-tab]").forEach(el=>el.addEventListener("click",e=>{e.preventDefault();setTab(el.dataset.tab);}));
if(location.hash==="#adventures")setTab("adventures");
renderCalendar();renderIdeas();renderPosts();
</script>
